resource app_signature "application/x-vnd.airos.docker-desktop";

resource app_flags B_SINGLE_LAUNCH;

// Generated by tools/make-icon.py; rc finds it next to this file.
resource vector_icon {
	import "docker-desktop.hvif"
};

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Docker Desktop for air/OS",
	long_info = "Manage Docker containers and images on air/OS"
};
